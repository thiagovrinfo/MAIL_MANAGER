<Window x:Class="Vrinfo.Mail.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — VRINFO Mail"
        Icon="pack://siteoforigin:,,,/Assets/app.ico"
        Width="760" Height="620"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancelar" Style="{StaticResource BtnGhost}" IsCancel="True" MinWidth="100" Margin="0,0,8,0"/>
        <Button Content="Salvar" Style="{StaticResource BtnPrimary}" MinWidth="100" Click="OnSave"/>
      </StackPanel>
    </DockPanel>
    <TabControl>
      <TabItem Header="Conta">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
          <StackPanel>
            <TextBlock Text="E-mail" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
            <TextBlock Text="Senha da caixa" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,4"/>
            <TextBlock Text="Deixe em branco para manter a senha atual." Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
            <TextBlock Text="Nome de exibição" FontWeight="SemiBold"/>
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
            <TextBlock Text="Endereços em cópia permanente (um por linha)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding AlwaysCcText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="88" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Conexão">
        <StackPanel Margin="8">
          <TextBlock Text="IMAP" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding ImapHost}" Margin="0,0,8,8"/>
            <TextBox Grid.Column="1" Text="{Binding ImapPort}" Margin="0,0,0,8"/>
          </Grid>
          <TextBlock Text="SMTP" FontWeight="SemiBold" Margin="0,8,0,6"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SmtpHost}" Margin="0,0,8,8"/>
            <TextBox Grid.Column="1" Text="{Binding SmtpPort}"/>
          </Grid>
        </StackPanel>
      </TabItem>
      <TabItem Header="Pastas">
        <StackPanel Margin="8">
          <TextBlock Text="Controle quais pastas inteligentes aparecem e recebem regras." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource Muted}"/>
          <CheckBox Content="Inovafarma" IsChecked="{Binding FolderInovafarmaEnabled}" Margin="0,0,0,8"/>
          <CheckBox Content="Hiper" IsChecked="{Binding FolderHiperEnabled}" Margin="0,0,0,8"/>
          <CheckBox Content="Contas" IsChecked="{Binding FolderContasEnabled}" Margin="0,0,0,8"/>
          <CheckBox Content="Contabilidade" IsChecked="{Binding FolderContabilidadeEnabled}" Margin="0,0,0,8"/>
          <CheckBox Content="Discord" IsChecked="{Binding FolderDiscordEnabled}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Regras">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
          <StackPanel>
            <CheckBox Content="Aplicar regras ao sincronizar" IsChecked="{Binding ApplyRulesOnSync}" Margin="0,0,0,12"/>
            <TextBlock Text="Palavras extras (um item por linha). Somam-se às regras internas." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="Inovafarma" FontWeight="SemiBold"/>
            <TextBox Text="{Binding InovafarmaTokens}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <TextBlock Text="Hiper" FontWeight="SemiBold"/>
            <TextBox Text="{Binding HiperTokens}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <TextBlock Text="Contas" FontWeight="SemiBold"/>
            <TextBox Text="{Binding ContasTokens}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <TextBlock Text="Contabilidade — palavras" FontWeight="SemiBold"/>
            <TextBox Text="{Binding ContabilidadeTokens}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <TextBlock Text="Contabilidade — remetentes" FontWeight="SemiBold"/>
            <TextBox Text="{Binding ContabilidadeSenders}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <TextBlock Text="Discord" FontWeight="SemiBold"/>
            <TextBox Text="{Binding DiscordTokens}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Aplicativo">
        <StackPanel Margin="8">
          <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10"/>
          <CheckBox Content="Ícone na bandeja (tray)" IsChecked="{Binding EnableTray}" Margin="0,0,0,10"/>
          <CheckBox Content="Minimizar para a bandeja ao fechar" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,10"/>
          <CheckBox Content="Sempre solicitar confirmação de leitura" IsChecked="{Binding AlwaysConfirmSend}" Margin="0,0,0,10"/>
          <CheckBox Content="Sempre enviar como prioridade alta" IsChecked="{Binding AlwaysSendHighPriority}"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
