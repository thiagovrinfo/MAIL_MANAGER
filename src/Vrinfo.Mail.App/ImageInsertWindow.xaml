<Window x:Class="Vrinfo.Mail.App.ImageInsertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inserir imagem"
        Width="420" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Click="OnCancel" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Inserir" Style="{StaticResource BtnPrimary}" Click="OnOk" IsDefault="True"/>
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Largura máxima (px)" Margin="0,0,0,4"/>
      <DockPanel Margin="0,0,0,12">
        <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat='{}{0:0}'}" Width="40"/>
        <Slider x:Name="WidthSlider" Minimum="240" Maximum="1200" Value="640" TickFrequency="40" IsSnapToTickEnabled="True"/>
      </DockPanel>
      <TextBlock Text="Qualidade JPEG" Margin="0,0,0,4"/>
      <DockPanel Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=QualitySlider, Path=Value, StringFormat='{}{0:0}'}" Width="40"/>
        <Slider x:Name="QualitySlider" Minimum="50" Maximum="95" Value="82" TickFrequency="1" IsSnapToTickEnabled="True"/>
      </DockPanel>
      <TextBlock Text="A imagem é redimensionada e compactada para o e-mail." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
    </StackPanel>
  </DockPanel>
</Window>
