<Window x:Class="Vrinfo.Mail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="VRINFO Mail"
        Icon="pack://siteoforigin:,,,/Assets/app.ico"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Grid>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Blue}" Padding="18,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="VRINFO Mail" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HeaderFg}" VerticalAlignment="Center"/>
          <TextBlock Text="  ·  leitor IMAP" Foreground="{DynamicResource HeaderSub}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="{Binding ComposeButtonLabel}" Style="{StaticResource BtnOnHeader}" Command="{Binding ComposeCommand}" Margin="0,0,8,0"/>
          <Button Content="Configurações" Style="{StaticResource BtnOnHeader}" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0"/>
          <Button Content="{Binding ThemeIcon}" Style="{StaticResource BtnOnHeader}" Command="{Binding ToggleThemeCommand}"
                  ToolTip="{Binding ThemeToggleLabel}" Padding="8,6" MinWidth="36" Opacity="0.7" FontSize="14"/>
        </StackPanel>
      </Grid>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource StatusBg}" Foreground="{DynamicResource Text}">
      <StatusBarItem>
        <TextBlock Text="{Binding Status}"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <ProgressBar Width="160" Height="8" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
      </StatusBarItem>
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding FolderColumnWidth}"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Background="{DynamicResource Panel}">
        <DockPanel DockPanel.Dock="Top" Margin="8,8,6,4" LastChildFill="False">
          <Button DockPanel.Dock="Right" Content="{Binding FolderToggleGlyph}" Command="{Binding ToggleFoldersCommand}"
                  ToolTip="{Binding FolderToggleHint}" Style="{StaticResource BtnGhost}" Padding="8,2" FontSize="14"
                  Opacity="0.55" MinWidth="28" BorderThickness="0"/>
          <TextBlock Text="Pastas" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Muted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding FoldersExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </DockPanel>
        <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="6,4"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
              <Setter Property="ToolTip" Value="{Binding Title}"/>
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnFolderItemRightClick"/>
              <Setter Property="ContextMenu">
                <Setter.Value>
                  <ContextMenu>
                    <MenuItem Header="✓  Marcar todos como lidos" Click="OnMarkFolderRead"/>
                  </ContextMenu>
                </Setter.Value>
              </Setter>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="Transparent">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListSelected}"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListHover}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="38"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Source="{Binding Logo}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.CachingHint="Cache"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" Margin="6,0,4,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.FoldersExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding Unread}" Foreground="{DynamicResource Blue}" FontWeight="SemiBold"
                           FontSize="11" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Unread}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.FoldersExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Line}"/>
      <DockPanel Grid.Column="2" Background="{DynamicResource Panel}">
        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
          <WrapPanel>
            <CheckBox Content="Não lidos" IsChecked="{Binding UnreadOnly}" Margin="0,0,10,4"/>
            <CheckBox Content="Anexos" IsChecked="{Binding AttachmentsOnly}" Margin="0,0,10,4"/>
            <CheckBox Content="Hoje" IsChecked="{Binding TodayOnly}" Margin="0,0,10,4"/>
            <CheckBox Content="Prioridade" IsChecked="{Binding HighPriorityOnly}" Margin="0,0,10,4"/>
            <CheckBox Content="Fiscal" IsChecked="{Binding FiscalOnly}" Margin="0,0,10,4"/>
          </WrapPanel>
          <WrapPanel>
            <Button Content="Lixeira" Style="{StaticResource BtnGhost}" Command="{Binding DeleteSelectedCommand}" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Contabilidade" Style="{StaticResource BtnGhost}" Command="{Binding TagContabilidadeCommand}" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Inovafarma" Style="{StaticResource BtnGhost}" Command="{Binding MoveToInovafarmaCommand}" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Hiper" Style="{StaticResource BtnGhost}" Command="{Binding MoveToHiperCommand}" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Pasta lida" Style="{StaticResource BtnGhost}" Command="{Binding MarkFolderReadCommand}" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Esvaziar lixo" Style="{StaticResource BtnGhost}" Command="{Binding EmptyTrashCommand}" Padding="8,4" Margin="0,0,4,4"/>
            <Button Content="Limpar news" Style="{StaticResource BtnGhost}" Command="{Binding CleanupNewslettersCommand}" Padding="8,4" Margin="0,0,4,4"/>
          </WrapPanel>
        </StackPanel>
        <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}"
                 SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                 BorderThickness="0"
                 Cursor="Hand"
                 SelectionMode="Single"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Focusable" Value="True"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnMessageItemMouseDown"/>
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnMessageItemRightClick"/>
              <Setter Property="ContextMenu">
                <Setter.Value>
                  <ContextMenu>
                    <MenuItem Header="✓  Marcar como lido" Click="OnMarkMessageRead"/>
                    <MenuItem Header="●  Marcar como não lido" Click="OnMarkMessageUnread"/>
                    <Separator/>
                    <MenuItem Header="Mover sempre este remetente para…">
                      <MenuItem Header="Inovafarma" Tag="Inovafarma" Click="OnCreateSenderFolderRule"/>
                      <MenuItem Header="Hiper" Tag="Hiper" Click="OnCreateSenderFolderRule"/>
                      <MenuItem Header="Contas" Tag="Contas" Click="OnCreateSenderFolderRule"/>
                      <MenuItem Header="Contabilidade" Tag="Contabilidade" Click="OnCreateSenderFolderRule"/>
                      <MenuItem Header="Discord" Tag="Discord" Click="OnCreateSenderFolderRule"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="🗑  Excluir" Click="OnDeleteMessage"/>
                  </ContextMenu>
                </Setter.Value>
              </Setter>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="MsgBd" Padding="0" Background="Transparent">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="MsgBd" Property="Background" Value="{DynamicResource ListSelected}"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="MsgBd" Property="Background" Value="{DynamicResource ListHover}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="8,6,10,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{DynamicResource Blue}">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSeen}" Value="False">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <StackPanel Grid.Column="1" Margin="2,0,8,0">
                  <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" FontSize="13">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSeen}" Value="False">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <DockPanel Margin="0,1,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Blue}" FontSize="12"/>
                      <TextBlock Text=" Anexo" Foreground="{DynamicResource Blue}" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayFrom}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.9">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ShowPreview}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                  <TextBlock Text="{Binding WhenShort}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                  <TextBlock Text="!" Foreground="{DynamicResource Danger}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Line}"/>
      <DockPanel Grid.Column="4" Background="{DynamicResource ReaderBg}">
        <Border DockPanel.Dock="Top" Padding="12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="{Binding SubjectLine}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding FromLine}" Foreground="{DynamicResource Muted}" Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="↩  Responder" Style="{StaticResource BtnPrimary}" Command="{Binding ReplyCommand}" Margin="0,0,6,0"/>
              <Button Content="↪  Encaminhar" Style="{StaticResource BtnGhost}" Command="{Binding ForwardCommand}" Margin="0,0,6,0"/>
              <Button Content="📎  SALVAR ANEXOS" Style="{StaticResource BtnPrimary}" Command="{Binding SaveAttachmentCommand}" Margin="0,0,6,0" FontWeight="SemiBold"
                      Visibility="{Binding HasOpenAttachments, Converter={StaticResource BoolToVis}}"/>
              <Button Content="★  Prioridade" Style="{StaticResource BtnGhost}" Command="{Binding ToggleFlagCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <ProgressBar DockPanel.Dock="Top" Height="6" Minimum="0" Maximum="100"
                     IsIndeterminate="True"
                     Visibility="{Binding IsOpeningMessage, Converter={StaticResource BoolToVis}}"/>
        <wv2:WebView2 x:Name="Reader"/>
      </DockPanel>
    </Grid>
    </DockPanel>
    <Border Background="{DynamicResource OverlayScrim}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
      <Border Width="320" Padding="20" CornerRadius="16" Background="{DynamicResource CardBg}" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Sincronizando caixa…" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,10"/>
          <ProgressBar IsIndeterminate="True" Height="8"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
